<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ethanliang</groupId>
    <artifactId>mcp-in-action</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mcp-in-action</name>
    <description>《MCP 实战手记》系列配套代码</description>

    <!--
      本 POM 仅作聚合器（aggregator），不继承 spring-boot-starter-parent。
      原因：各示例模块使用不同的 Spring Boot 大版本（旧版 3.x / 新版 4.x），
      因此由各模块自行声明自己的 parent。
    -->
    <modules>
        <module>03-stateless-migration/legacy-sse</module>
        <module>03-stateless-migration/stateless</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
