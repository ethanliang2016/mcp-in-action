<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.ethanliang</groupId>
    <artifactId>mcp-gateway</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>mcp-gateway</name>
    <description>第 6 篇 · 自建 MCP 网关：多后端聚合、命名空间隔离与故障降级（Spring Boot 4.x + Java 21 + MCP Java SDK 2.0.0 + STATELESS）</description>

    <properties>
        <java.version>21</java.version>
        <mcp.sdk.version>2.0.0</mcp.sdk.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          网关同时是「对上游的 server」和「对下游的 client」，
          两边都用 MCP Java SDK 的底层 API，不引 Spring AI 的注解式 starter：
          工具列表是运行时从后端拉来的，注解声明不出来。
        -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>

        <!-- JSON 映射实现（jackson3），SDK 通过 ServiceLoader 发现，代码里不直接引用 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson3</artifactId>
            <version>${mcp.sdk.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
